# ─── Smart Contract (Hardhat) ─────────────────────────────────────────────────
# Your deployer wallet private key (NEVER commit this)
PRIVATE_KEY=0x...

# RPC endpoints
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
SEPOLIA_RPC=https://rpc.sepolia.org

# Block explorer API keys (for contract verification)
POLYGONSCAN_KEY=
ETHERSCAN_KEY=

# ─── Backend Server ────────────────────────────────────────────────────────────
# Deployed contract address (fill in after deployment)
CONTRACT_ADDRESS=0x...

# Institution wallet (for recording verifications on-chain)
INSTITUTION_PRIVATE_KEY=0x...

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Server port
PORT=3001

# ─── Frontend (Vite) ───────────────────────────────────────────────────────────
# Contract addresses per network (fill in after deployment)
VITE_CONTRACT_AMOY=0x...
VITE_CONTRACT_SEPOLIA=0x...
VITE_CONTRACT_LOCAL=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Backend API URL
VITE_API_URL=http://localhost:3001
